# Python
__pycache__/
*.py[cod]

# Operator-supplied material — deliberately NOT distributed.
# Each group provides its own; see configs/README.md.
configs/*.ini
configs/*.conf
configs/*.csv
configs/*.zcp
configs/*.txt
configs/areas/*.json
# ...but the sample IS tracked. It ships as .json.sample so it can never be
# mistaken for a live area: copy it to <your-area>.json rather than editing it.
!configs/areas/example-area.json.sample

# Reference library and cached packages are large and license-varied
docs/*.pdf
scripts/Packages/*.deb
scripts/Packages/**/*.jpg
scripts/Packages/**/*.png

# Runtime noise
*.log
*.part
